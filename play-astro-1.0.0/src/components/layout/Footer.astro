    </div>
  </div>

  <div class="mt-12 border-t border-[#8890A4] border-opacity-40 py-8 lg:mt-[60px]">
    <div class="container">
      <div class="text-center">
        <p class="text-base text-gray-7">
          © 2024 Swimming LST. All rights reserved.
        </p>
      </div>
    </div>
  </div>
</footer>
<!-- ====== Footer Section End -->